{
	"name": "telly",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/add-cron.ts",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync && node scripts/gen-types.ts || echo ''",
		"check": "node scripts/gen-types.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"gen": "node scripts/gen-types.ts",
		"db:migrate:local": "wrangler d1 migrations apply telly --local",
		"db:migrate:remote": "wrangler d1 migrations apply telly --remote",
		"deploy": "npm run build && npm run deploy:ci",
		"deploy:ci": "wrangler d1 migrations apply telly --remote && wrangler deploy",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.18.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"workerd@1.20261103.1": true
	},
	"dependencies": {
		"@block65/webcrypto-web-push": "^2.0.0",
		"@fontsource-variable/big-shoulders-display": "^5.3.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"auth": "github:jonhaddow/auth"
	}
}
